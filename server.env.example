# One deployment's settings, read by scripts/serve.sh.
# Copy to server.env (gitignored) and edit.  Everything machine-specific is
# here; the code never changes when the service moves hosts.

# Where clients connect.  Use a DNS name that follows the service around
# (dynamic DNS pointing at the laptop today, the VPS tomorrow): capability
# files embed this address, so a stable name means never re-issuing them.
BENCH_PUBLIC_ADDRESS=tcp:bench.example.org:7000

# What the daemon binds.
BENCH_LISTEN=tcp:0.0.0.0:7000

# Queue + server identity (secret-key.pem) + capability files.  Moving the
# service = moving this directory.
#BENCH_STATE_DIR=$HOME/.ocaml-bench-service

# github (default): vs= refs, PR heads and merge bases resolve via git.
# offline: versions and commit shas only; refuses PR submissions.
#BENCH_RESOLVER=github

#BENCH_SERVICE_CONFIG=service.json

# Where acknowledgement and completion links point.  With Pages publishing
# (below) set it to the Pages site, so PR readers land somewhere reachable:
#BENCH_BASE_URL=https://<user>.github.io/<repo>

# Publish the webview + run bundles + dashboards to a GitHub Pages repo
# (scripts/publish_pages.sh; needs gh auth with push access).  Empty = off.
#BENCH_PAGES_REPO=<user>/<repo>

# The repos the server reads.  These default to the server's OWN clones under
# <state>/git (created by scripts/server-setup.sh), and normally need no entry
# here.  Setting one to a working checkout points the service at a tree
# somebody else edits: its idea of "latest" becomes whenever that tree was
# last fetched, and a rewrite or gc there can drop a commit a pin names.
#BENCH_GIT_DIR=$BENCH_STATE_DIR/git
#RUNNING_NG_REPO=$BENCH_GIT_DIR/running-ng
#RUNNING_NG_REF=origin/adding-ocaml-support
#MACRO_BENCHES_REPO=$BENCH_GIT_DIR/macro-benches
#OLLY_REPO=$BENCH_GIT_DIR/runtime_events_tools
#DASHBOARD_REPO=$BENCH_GIT_DIR/ocaml-bench-dashboard
#VOCAB=$DASHBOARD_REPO/schema/json/vocab.json

# Double-role host (this machine also runs bench-agent): give the service its
# own opam root so `make switch`/`make deps` cannot take the root lock while
# running-ng is provisioning a compiler mid-run.  Setup-time only; a private
# root rebuilds a compiler once.
#BENCH_OPAMROOT=$BENCH_STATE_DIR/opam
