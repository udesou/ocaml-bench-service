# One deployment's settings, read by scripts/serve.sh.
# Copy to server.env (gitignored) and edit.  Everything machine-specific is
# here; the code never changes when the service moves hosts.

# Where clients connect.  Use a DNS name that follows the service around
# (dynamic DNS pointing at the laptop today, the VPS tomorrow): capability
# files embed this address, so a stable name means never re-issuing them.
BENCH_PUBLIC_ADDRESS=tcp:bench.example.org:7000

# What the daemon binds.
BENCH_LISTEN=tcp:0.0.0.0:7000

# Queue + server identity (secret-key.pem) + capability files.  Moving the
# service = moving this directory.
#BENCH_STATE_DIR=$HOME/.ocaml-bench-service

# github (default): vs= refs, PR heads and merge bases resolve via git.
# offline: versions and commit shas only; refuses PR submissions.
#BENCH_RESOLVER=github

#BENCH_SERVICE_CONFIG=service.json
#BENCH_BASE_URL=http://localhost
#RUNNING_NG_REPO=$HOME/running-ng
#RUNNING_NG_REF=origin/adding-ocaml-support
#VOCAB=$HOME/ocaml-bench-dashboard/schema/json/vocab.json
