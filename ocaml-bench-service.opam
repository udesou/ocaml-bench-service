# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Comment-triggered benchmarking service for OCaml compiler PRs"
description:
  "Turns a /bench comment on a pull request into a validated running-ng run, schedules it on a bench machine, and publishes contract artifacts plus a report. See benchmarking-service-design.md."
maintainer: ["eduardo@tarides.com"]
authors: ["Eduardo Souza"]
license: "ISC"
homepage: "https://github.com/udesou/ocaml-bench-service"
bug-reports: "https://github.com/udesou/ocaml-bench-service/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16" & >= "3.16"}
  "yojson" {>= "2.0"}
  "capnp" {>= "3.6"}
  "capnp-rpc" {>= "2.1"}
  "capnp-rpc-unix" {>= "2.1"}
  "eio_main"
  "logs"
  "fmt"
  "mirage-crypto-rng" {>= "1.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/udesou/ocaml-bench-service.git"
